<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="default.asp" />
      </files>
    </defaultDocument>

    <staticContent>
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
      <remove fileExtension=".m4a" />
      <mimeMap fileExtension=".m4a" mimeType="audio/mp4" />
      <remove fileExtension=".ogg" />
      <mimeMap fileExtension=".ogg" mimeType="audio/ogg" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <security>
      <requestFiltering>
        <!-- 50 MB para subir archivos de audio -->
        <requestLimits maxAllowedContentLength="52428800" />
        <!-- Código de servidor nunca accesible desde el navegador -->
        <hiddenSegments>
          <add segment="includes" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Respeta las páginas 403/404 generadas por la aplicación -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>

  <!-- Carpetas de medios: solo archivos estáticos permitidos (impide ejecutar .asp subidos) -->
  <location path="songFiles">
    <system.webServer>
      <security><requestFiltering><fileExtensions allowUnlisted="false">
        <add fileExtension=".mp3" allowed="true" /><add fileExtension=".m4a" allowed="true" />
        <add fileExtension=".ogg" allowed="true" /><add fileExtension=".wav" allowed="true" />
      </fileExtensions></requestFiltering></security>
    </system.webServer>
  </location>
  <location path="albumImages">
    <system.webServer>
      <security><requestFiltering><fileExtensions allowUnlisted="false">
        <add fileExtension=".jpg" allowed="true" /><add fileExtension=".jpeg" allowed="true" /><add fileExtension=".png" allowed="true" />
        <add fileExtension=".webp" allowed="true" /><add fileExtension=".gif" allowed="true" />
      </fileExtensions></requestFiltering></security>
    </system.webServer>
  </location>
  <location path="ArtistImages">
    <system.webServer>
      <security><requestFiltering><fileExtensions allowUnlisted="false">
        <add fileExtension=".jpg" allowed="true" /><add fileExtension=".jpeg" allowed="true" /><add fileExtension=".png" allowed="true" />
        <add fileExtension=".webp" allowed="true" /><add fileExtension=".gif" allowed="true" />
      </fileExtensions></requestFiltering></security>
    </system.webServer>
  </location>
  <location path="userImages">
    <system.webServer>
      <security><requestFiltering><fileExtensions allowUnlisted="false">
        <add fileExtension=".jpg" allowed="true" /><add fileExtension=".jpeg" allowed="true" /><add fileExtension=".png" allowed="true" />
        <add fileExtension=".webp" allowed="true" /><add fileExtension=".gif" allowed="true" />
      </fileExtensions></requestFiltering></security>
    </system.webServer>
  </location>
  <location path="playlistImages">
    <system.webServer>
      <security><requestFiltering><fileExtensions allowUnlisted="false">
        <add fileExtension=".jpg" allowed="true" /><add fileExtension=".jpeg" allowed="true" /><add fileExtension=".png" allowed="true" />
        <add fileExtension=".webp" allowed="true" /><add fileExtension=".gif" allowed="true" />
      </fileExtensions></requestFiltering></security>
    </system.webServer>
  </location>
</configuration>
