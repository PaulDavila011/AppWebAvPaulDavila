<?xml version="1.0" encoding="utf-8"?>
<!--
    PoliMusic - Configuracion de IIS
    ========================================================================
    Aplicacion ASP clasico. Requiere un grupo de aplicaciones con
    "Modo de canalizacion administrada = Clasico".

    Notas importantes aprendidas durante el desarrollo:
      * Los ajustes de <asp> van como ELEMENTOS HIJOS (session, limits).
        Si se usan como atributos (sessionTimeout, codePage, bufferingOn) IIS
        responde HTTP 501 "Error en nueva aplicacion".
      * El elemento <cache> dentro de <asp> exige desbloquear otra seccion
        adicional, por eso se omite: no aporta valor a este proyecto.
      * Se evita declarar <globalization>, <security> y <httpProtocol> en la
        aplicacion porque estan bloqueados por omision en IIS completo. La
        codificacion se controla con CodePage="65001" en cada pagina ASP.
      * Los comentarios XML no pueden contener dos guiones seguidos.
-->
<configuration>

    <system.webServer>

        <!-- Pagina de inicio -->
        <defaultDocument enabled="true">
            <files>
                <clear />
                <add value="default.asp" />
                <add value="index.asp" />
                <add value="login.asp" />
            </files>
        </defaultDocument>

        <!-- Motor de ASP clasico -->
        <asp scriptErrorSentToBrowser="true" enableParentPaths="false">
            <session allowSessionState="true" timeout="00:30:00" />
            <limits scriptTimeout="00:01:30" maxRequestEntityAllowed="15728640" />
        </asp>

        <!-- Sin listado de directorios -->
        <directoryBrowse enabled="false" />

        <!-- Tipos MIME necesarios para audio, imagen y fuentes -->
        <staticContent>
            <remove fileExtension=".mp3" />
            <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
            <remove fileExtension=".m4a" />
            <mimeMap fileExtension=".m4a" mimeType="audio/mp4" />
            <remove fileExtension=".ogg" />
            <mimeMap fileExtension=".ogg" mimeType="audio/ogg" />
            <remove fileExtension=".wav" />
            <mimeMap fileExtension=".wav" mimeType="audio/wav" />
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".svg" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        </staticContent>

    </system.webServer>

</configuration>
